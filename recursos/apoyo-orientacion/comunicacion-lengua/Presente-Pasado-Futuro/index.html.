<!DOCTYPE html>

<html lang="es">

<head>

  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Misión del tiempo visual</title>

  <style>

    :root{

      --bg1:#eef6ff;

      --bg2:#fff8e8;

      --card:#ffffff;

      --ink:#24324a;

      --accent:#6c63ff;

      --good:#1f9d55;

      --bad:#d64545;

      --gold:#ffbf3f;

      --soft:#dfe8ff;

      --past:#dff0ff;

      --present:#e8ffe5;

      --future:#fff0d8;

    }

    *{box-sizing:border-box}

    body{

      margin:0;

      font-family: Arial, Helvetica, sans-serif;

      background: linear-gradient(180deg, var(--bg1), var(--bg2));

      color:var(--ink);

    }

    .wrap{

      max-width:980px;

      margin:0 auto;

      padding:20px;

    }

    .top{

      background:rgba(255,255,255,.85);

      border:3px solid #d8e3ff;

      border-radius:24px;

      padding:18px;

      box-shadow:0 10px 30px rgba(49,66,120,.08);

      text-align:center;

    }

    h1{

      margin:0 0 10px;

      font-size:clamp(28px, 4vw, 42px);

    }

    .subtitle{

      font-size:clamp(16px, 2vw, 22px);

      margin:0;

    }

    .hud{

      display:grid;

      grid-template-columns:1fr 1fr 1fr;

      gap:14px;

      margin:18px 0;

    }

    .pill{

      background:var(--card);

      border-radius:20px;

      border:3px solid #d8e3ff;

      padding:14px;

      text-align:center;

      font-weight:bold;

      font-size:clamp(18px, 2.4vw, 24px);

      box-shadow:0 8px 20px rgba(49,66,120,.06);

    }

    .game{

      background:var(--card);

      border:4px solid #d8e3ff;

      border-radius:28px;

      box-shadow:0 12px 30px rgba(49,66,120,.10);

      padding:22px;

    }

    .mission{

      text-align:center;

      font-size:clamp(24px, 3vw, 34px);

      margin:0 0 8px;

    }

    .prompt{

      text-align:center;

      background:#f7f9ff;

      border:3px dashed #cfdcff;

      border-radius:24px;

      padding:18px;

      margin-bottom:18px;

    }

    .prompt .emoji{

      font-size:90px;

      line-height:1;

      margin-bottom:8px;

      display:block;

    }

    .prompt .person{

      font-size:clamp(18px, 2vw, 24px);

      font-weight:bold;

      color:#55607a;

      margin-bottom:10px;

    }

    .prompt .sentence{

      font-size:clamp(34px, 5vw, 54px);

      font-weight:900;

      letter-spacing:.4px;

      margin:0;

    }

    .listenBtn{

      margin-top:14px;

      border:none;

      border-radius:999px;

      background:#6c63ff;

      color:white;

      font-size:20px;

      font-weight:bold;

      padding:12px 18px;

      cursor:pointer;

      box-shadow:0 8px 18px rgba(108,99,255,.22);

    }

    .question{

      text-align:center;

      font-size:clamp(22px, 3vw, 32px);

      font-weight:800;

      margin:12px 0 18px;

    }

    .options{

      display:grid;

      grid-template-columns:repeat(3, 1fr);

      gap:14px;

    }

    .opt{

      border:none;

      border-radius:24px;

      padding:18px 16px;

      cursor:pointer;

      min-height:170px;

      font-size:20px;

      font-weight:bold;

      color:var(--ink);

      box-shadow:0 8px 20px rgba(49,66,120,.08);

      transition:transform .12s ease, box-shadow .12s ease;

    }

    .opt:hover{transform:translateY(-2px); box-shadow:0 12px 24px rgba(49,66,120,.12)}

    .opt:active{transform:scale(.99)}

    .past{background:var(--past)}

    .present{background:var(--present)}

    .future{background:var(--future)}

    .arrow{

      display:block;

      font-size:58px;

      line-height:1;

      margin-bottom:8px;

    }

    .mainLabel{

      display:block;

      font-size:clamp(24px, 2.7vw, 32px);

      margin-bottom:4px;

    }

    .subLabel{

      display:block;

      font-size:clamp(20px, 2.2vw, 28px);

      opacity:.95;

    }

    .feedback{

      margin-top:18px;

      min-height:84px;

      border-radius:22px;

      padding:16px;

      text-align:center;

      font-size:clamp(22px, 2.6vw, 30px);

      font-weight:900;

      display:flex;

      align-items:center;

      justify-content:center;

      background:#f8fbff;

      border:3px dashed #d8e3ff;

    }

    .good{color:var(--good)}

    .bad{color:var(--bad)}

    .controls{

      display:flex;

      justify-content:center;

      gap:12px;

      margin-top:16px;

      flex-wrap:wrap;

    }

    .controls button{

      border:none;

      border-radius:999px;

      padding:12px 18px;

      font-size:18px;

      font-weight:bold;

      cursor:pointer;

      background:#edf3ff;

      color:var(--ink);

    }

    .hidden{display:none !important}

    .finalBox{

      text-align:center;

      padding:20px 10px 6px;

    }

    .trophy{

      font-size:94px;

      line-height:1;

      display:block;

      margin-bottom:8px;

    }

    .big{

      font-size:clamp(28px, 4vw, 42px);

      font-weight:900;

      margin:8px 0;

    }

    .small{

      font-size:clamp(18px, 2.4vw, 26px);

      margin:8px auto 18px;

      max-width:700px;

    }

    .stars{color:var(--gold)}

    .note{

      margin-top:12px;

      text-align:center;

      font-size:16px;

      color:#5e6a84;

    }

    @media (max-width:800px){

      .options{grid-template-columns:1fr}

      .hud{grid-template-columns:1fr}

      .opt{min-height:unset}

    }

  </style>

</head>

<body>

  <div class="wrap">

    <div class="top">

      <h1>🚀 Misión del tiempo visual</h1>

      <p class="subtitle">Mira el dibujo, escucha la forma verbal y elige su tiempo.</p>

    </div>



    <div class="hud">

      <div class="pill">⭐ Estrellas: <span id="score">0</span> / 10</div>

      <div class="pill">🎯 Misión: llegar a 10</div>

      <div class="pill">🔊 Sonido: <span id="soundState">activado</span></div>

    </div>



    <div class="game" id="gameArea">

      <h2 class="mission">¡Elige el tiempo correcto!</h2>

      <div class="prompt">

        <span class="emoji" id="emoji">🎨</span>

        <div class="person" id="person">Ana</div>

        <p class="sentence" id="sentence">pinta</p>

        <button class="listenBtn" id="listenBtn">🔊 Escuchar despacio</button>

      </div>



      <div class="question">¿En qué tiempo está la forma verbal?</div>



      <div class="options" id="options">

        <button class="opt present" data-choice="presente">

          <span class="arrow">⬇️</span>

          <span class="mainLabel">PRESENTE</span>

          <span class="subLabel">hoy</span>

        </button>

        <button class="opt past" data-choice="pasado">

          <span class="arrow">⬅️</span>

          <span class="mainLabel">PASADO</span>

          <span class="subLabel">ayer</span>

        </button>

        <button class="opt future" data-choice="futuro">

          <span class="arrow">➡️</span>

          <span class="mainLabel">FUTURO</span>

          <span class="subLabel">mañana</span>

        </button>

      </div>



      <div class="feedback" id="feedback">Pulsa la opción correcta.</div>



      <div class="controls">

        <button id="nextBtn" class="hidden">➡️ Siguiente misión</button>

        <button id="repeatBtn">🔁 Volver a escuchar despacio</button>

        <button id="toggleSoundBtn">🔇 Activar / desactivar sonido</button>

      </div>



      <div class="note">Apoyo visual: presente = ⬇ hoy · pasado = ⬅ ayer · futuro = ➡ mañana</div>

    </div>



    <div class="game hidden" id="finalArea">

      <div class="finalBox">

        <span class="trophy">🏆</span>

        <div class="big">¡Misión conseguida!</div>

        <div class="small">Has logrado <span class="stars">10 estrellas</span>. ¡Eres una súper viajera del tiempo! 🌟🚀</div>

        <div class="small">¡Lo has hecho fenomenal! Has reconocido muy bien <b>presente</b>, <b>pasado</b> y <b>futuro</b>.</div>

        <button id="restartBtn" style="border:none;border-radius:999px;padding:14px 20px;font-size:20px;font-weight:bold;cursor:pointer;background:#6c63ff;color:white;">🔄 Jugar otra vez</button>

      </div>

    </div>

  </div>



  <script>

    const items = [

      {emoji:'🎨', person:'Ana', sentence:'pinta', tense:'presente', speak:'Ana pinta.'},

      {emoji:'🎨', person:'Ana', sentence:'pintó', tense:'pasado', speak:'Ana pintó.'},

      {emoji:'🎨', person:'Ana', sentence:'pintará', tense:'futuro', speak:'Ana pintará.'},



      {emoji:'⚽', person:'Leo', sentence:'juega', tense:'presente', speak:'Leo juega.'},

      {emoji:'⚽', person:'Leo', sentence:'jugó', tense:'pasado', speak:'Leo jugó.'},

      {emoji:'⚽', person:'Leo', sentence:'jugará', tense:'futuro', speak:'Leo jugará.'},



      {emoji:'🍎', person:'Yo', sentence:'como', tense:'presente', speak:'Yo como.'},

      {emoji:'🍎', person:'Yo', sentence:'comí', tense:'pasado', speak:'Yo comí.'},

      {emoji:'🍎', person:'Yo', sentence:'comeré', tense:'futuro', speak:'Yo comeré.'},



      {emoji:'🛁', person:'Tú', sentence:'te lavas', tense:'presente', speak:'Tú te lavas.'},

      {emoji:'🛁', person:'Tú', sentence:'te lavaste', tense:'pasado', speak:'Tú te lavaste.'},

      {emoji:'🛁', person:'Tú', sentence:'te lavarás', tense:'futuro', speak:'Tú te lavarás.'},



      {emoji:'📚', person:'Él', sentence:'lee', tense:'presente', speak:'Él lee.'},

      {emoji:'📚', person:'Él', sentence:'leyó', tense:'pasado', speak:'Él leyó.'},

      {emoji:'📚', person:'Él', sentence:'leerá', tense:'futuro', speak:'Él leerá.'},



      {emoji:'🏃', person:'Marta', sentence:'corre', tense:'presente', speak:'Marta corre.'},

      {emoji:'🏃', person:'Marta', sentence:'corrió', tense:'pasado', speak:'Marta corrió.'},

      {emoji:'🏃', person:'Marta', sentence:'correrá', tense:'futuro', speak:'Marta correrá.'},



      {emoji:'🧩', person:'Sara', sentence:'arma', tense:'presente', speak:'Sara arma un puzle.'},

      {emoji:'🧩', person:'Sara', sentence:'armó', tense:'pasado', speak:'Sara armó un puzle.'},

      {emoji:'🧩', person:'Sara', sentence:'armará', tense:'futuro', speak:'Sara armará un puzle.'},



      {emoji:'🚲', person:'Yo', sentence:'voy', tense:'presente', speak:'Yo voy en bici.'},

      {emoji:'🚲', person:'Yo', sentence:'fui', tense:'pasado', speak:'Yo fui en bici.'},

      {emoji:'🚲', person:'Yo', sentence:'iré', tense:'futuro', speak:'Yo iré en bici.'},



      {emoji:'🎵', person:'Él', sentence:'canta', tense:'presente', speak:'Él canta.'},

      {emoji:'🎵', person:'Él', sentence:'cantó', tense:'pasado', speak:'Él cantó.'},

      {emoji:'🎵', person:'Él', sentence:'cantará', tense:'futuro', speak:'Él cantará.'},



      {emoji:'🧱', person:'Tú', sentence:'construyes', tense:'presente', speak:'Tú construyes una torre.'},

      {emoji:'🧱', person:'Tú', sentence:'construiste', tense:'pasado', speak:'Tú construiste una torre.'},

      {emoji:'🧱', person:'Tú', sentence:'construirás', tense:'futuro', speak:'Tú construirás una torre.'}

    ];



    let score = 0;

    let current = null;

    let awaitingNext = false;

    let soundOn = true;



    const scoreEl = document.getElementById('score');

    const emojiEl = document.getElementById('emoji');

    const personEl = document.getElementById('person');

    const sentenceEl = document.getElementById('sentence');

    const feedbackEl = document.getElementById('feedback');

    const nextBtn = document.getElementById('nextBtn');

    const repeatBtn = document.getElementById('repeatBtn');

    const listenBtn = document.getElementById('listenBtn');

    const soundStateEl = document.getElementById('soundState');

    const gameArea = document.getElementById('gameArea');

    const finalArea = document.getElementById('finalArea');

    const restartBtn = document.getElementById('restartBtn');

    const toggleSoundBtn = document.getElementById('toggleSoundBtn');



    function shuffledCopy(arr){

      return arr.map(v => ({sort: Math.random(), value:v})).sort((a,b)=>a.sort-b.sort).map(({value})=>value);

    }



    let queue = shuffledCopy(items);



    function loadItem(){

      if(score >= 10){

        finishGame();

        return;

      }

      if(queue.length === 0) queue = shuffledCopy(items);

      current = queue.pop();

      awaitingNext = false;

      emojiEl.textContent = current.emoji;

      personEl.textContent = current.person;

      sentenceEl.textContent = current.sentence;

      feedbackEl.textContent = 'Pulsa la opción correcta.';

      feedbackEl.className = 'feedback';

      nextBtn.classList.add('hidden');

      setOptionsDisabled(false);

      setTimeout(()=>speakCurrent(), 350);

    }



    function setOptionsDisabled(disabled){

      document.querySelectorAll('.opt').forEach(btn => btn.disabled = disabled);

    }



    function updateScore(){

      scoreEl.textContent = score;

    }



    function speakCurrent(){

      if(!('speechSynthesis' in window)) return;

      const utt = new SpeechSynthesisUtterance(current.speak);

      utt.lang = 'es-ES';

      utt.rate = 0.48;

      window.speechSynthesis.cancel();

      window.speechSynthesis.speak(utt);

    }



    function playTone(type){

      if(!soundOn) return;

      try{

        const ctx = new (window.AudioContext || window.webkitAudioContext)();

        const osc = ctx.createOscillator();

        const gain = ctx.createGain();

        osc.connect(gain);

        gain.connect(ctx.destination);

        const now = ctx.currentTime;

        if(type === 'good'){

          osc.type = 'sine';

          osc.frequency.setValueAtTime(523.25, now);

          osc.frequency.setValueAtTime(659.25, now + 0.12);

          osc.frequency.setValueAtTime(783.99, now + 0.24);

          gain.gain.setValueAtTime(0.001, now);

          gain.gain.exponentialRampToValueAtTime(0.18, now + 0.02);

          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

          osc.start(now);

          osc.stop(now + 0.46);

        } else {

          osc.type = 'triangle';

          osc.frequency.setValueAtTime(220, now);

          osc.frequency.setValueAtTime(180, now + 0.18);

          gain.gain.setValueAtTime(0.001, now);

          gain.gain.exponentialRampToValueAtTime(0.18, now + 0.02);

          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

          osc.start(now);

          osc.stop(now + 0.36);

        }

      }catch(e){}

    }



    function reinforceCorrect(){

      const messages = [

        '🌟 ¡Muy bien! ¡Has acertado!',

        '👏 ¡Genial! Esa es la respuesta correcta.',

        '🚀 ¡Estupendo! Sigue así.',

        '⭐ ¡Perfecto! Has ganado una estrella.',

        '🎉 ¡Lo estás haciendo fenomenal!'

      ];

      return messages[Math.floor(Math.random()*messages.length)];

    }



    function handleChoice(choice){

      if(awaitingNext) return;

      if(choice === current.tense){

        score += 1;

        updateScore();

        playTone('good');

        feedbackEl.textContent = reinforceCorrect();

        feedbackEl.className = 'feedback good';

        awaitingNext = true;

        setOptionsDisabled(true);

        nextBtn.classList.remove('hidden');

        if(score >= 10){

          nextBtn.textContent = '🏆 Ver mi premio';

        } else {

          nextBtn.textContent = '➡️ Siguiente misión';

        }

      } else {

        playTone('bad');

        feedbackEl.textContent = '❌ Inténtalo otra vez.';

        feedbackEl.className = 'feedback bad';

      }

    }



    function finishGame(){

      playTone('good');

      setTimeout(()=>playTone('good'), 250);

      gameArea.classList.add('hidden');

      finalArea.classList.remove('hidden');

      if('speechSynthesis' in window){

        const utt = new SpeechSynthesisUtterance('¡Misión conseguida! Has logrado diez estrellas. ¡Muy bien!');

        utt.lang = 'es-ES';

        utt.rate = 0.58;

        window.speechSynthesis.cancel();

        window.speechSynthesis.speak(utt);

      }

    }



    document.querySelectorAll('.opt').forEach(btn => {

      btn.addEventListener('click', () => handleChoice(btn.dataset.choice));

    });



    nextBtn.addEventListener('click', () => {

      if(score >= 10){

        finishGame();

      } else {

        loadItem();

      }

    });



    repeatBtn.addEventListener('click', speakCurrent);

    listenBtn.addEventListener('click', speakCurrent);



    toggleSoundBtn.addEventListener('click', () => {

      soundOn = !soundOn;

      soundStateEl.textContent = soundOn ? 'activado' : 'desactivado';

      if(soundOn) playTone('good');

    });



    restartBtn.addEventListener('click', () => {

      score = 0;

      updateScore();

      queue = shuffledCopy(items);

      gameArea.classList.remove('hidden');

      finalArea.classList.add('hidden');

      nextBtn.textContent = '➡️ Siguiente misión';

      loadItem();

    });



    updateScore();

    loadItem();

  </script>

</body>

</html>
